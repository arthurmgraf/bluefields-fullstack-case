    {"id": "profiles-cols", "type": "text", "x": 100, "y": 168, "width": 240, "height": 130, "angle": 0, "strokeColor": "#000d2c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 5, "version": 1, "versionNonce": 5, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "🔑 id          uuid PK\n    full_name  text\n    created_at timestamptz\n\nFK → auth.users(id)\nCASCADE on delete\n\nTrigger: handle_new_user", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "baseline": 11, "containerId": null, "originalText": "🔑 id          uuid PK\n    full_name  text\n    created_at timestamptz\n\nFK → auth.users(id)\nCASCADE on delete\n\nTrigger: handle_new_user"},

