    {"id": "rls-box", "type": "rectangle", "x": 80, "y": 540, "width": 1120, "height": 220, "angle": 0, "strokeColor": "#000d2c", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 20, "version": 1, "versionNonce": 20, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false},
    {"id": "rls-title", "type": "text", "x": 100, "y": 555, "width": 500, "height": 26, "angle": 0, "strokeColor": "#000d2c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 21, "version": 1, "versionNonce": 21, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "🔒 Row Level Security (RLS) — enforced at Postgres layer", "fontSize": 18, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "baseline": 16, "containerId": null, "originalText": "🔒 Row Level Security (RLS) — enforced at Postgres layer"},
    {"id": "rls-text", "type": "text", "x": 100, "y": 595, "width": 1080, "height": 150, "angle": 0, "strokeColor": "#000d2c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 22, "version": 1, "versionNonce": 22, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "profiles                — SELECT: auth.role()='authenticated'           UPDATE: auth.uid() = id (self-edit only)\n\nstartups                — SELECT/ALL: auth.role()='authenticated'        (any auth user can read or write)\n\nstartup_updates         — SELECT: auth.role()='authenticated'           INSERT: auth.uid() = author_id (only your own)\n\nThe NEXT_PUBLIC_SUPABASE_ANON_KEY ships to the browser.  Security does NOT depend on key secrecy —\nit depends on these policies. Anonymous traffic gets zero rows back from any table without a valid JWT cookie.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "baseline": 11, "containerId": null, "originalText": "profiles                — SELECT: auth.role()='authenticated'           UPDATE: auth.uid() = id (self-edit only)\n\nstartups                — SELECT/ALL: auth.role()='authenticated'        (any auth user can read or write)\n\nstartup_updates         — SELECT: auth.role()='authenticated'           INSERT: auth.uid() = author_id (only your own)\n\nThe NEXT_PUBLIC_SUPABASE_ANON_KEY ships to the browser.  Security does NOT depend on key secrecy —\nit depends on these policies. Anonymous traffic gets zero rows back from any table without a valid JWT cookie."}
